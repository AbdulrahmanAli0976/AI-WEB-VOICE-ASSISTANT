#!/bin/sh
set -e

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

if printf '%s' "$first_line" | grep -Eq '^(feat|fix|refactor|chore|docs)(\([^)]+\))?: .+'; then
  exit 0
fi

echo "ERROR: Commit message must follow Conventional Commit format."
echo "Expected: type(scope): summary"
echo "Allowed types: feat, fix, refactor, chore, docs"
exit 1
