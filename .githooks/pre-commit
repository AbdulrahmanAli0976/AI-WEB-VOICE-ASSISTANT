#!/bin/sh
set -e

staged="$(git diff --cached --name-only)"

if [ -z "$staged" ]; then
  exit 0
fi

non_docs="$(printf '%s\n' "$staged" | grep -vE '^docs/(PROJECT_LOG\.md|ARCHITECTURE_STATE\.md|CHANGELOG\.md)$' || true)"

if [ -z "$non_docs" ]; then
  exit 0
fi

missing=""
for file in docs/PROJECT_LOG.md docs/ARCHITECTURE_STATE.md docs/CHANGELOG.md; do
  if ! printf '%s\n' "$staged" | grep -qx "$file"; then
    missing="$missing $file"
  fi
done

if [ -n "$missing" ] && [ -z "$TRACKING_BYPASS" ]; then
  echo "ERROR: Missing required tracking files in staged changes:$missing"
  echo "Run scripts/track-change.ps1 to update tracking docs and commit."
  exit 1
fi

exit 0
